-- Hoisted CFrame/velocity setters (avoid per-call closures in hot loops)
local function _setCF(hrp, cf) hrp.CFrame = cf end
local function _setVel(hrp, v) hrp.AssemblyLinearVelocity = v end
local function _setAng(hrp, v) hrp.AssemblyAngularVelocity = v end

local PHI = (1 + math.sqrt(5)) / 2
local function fibSpherePoint(i, n, r)
    local theta = 2 * math.pi * i / PHI
    local phi = math.acos(math.clamp(1 - 2 * (i + 0.5) / n, -1, 1))
    return Vector3.new(
        r * math.sin(phi) * math.cos(theta),
        r * math.cos(phi),
        r * math.sin(phi) * math.sin(theta)
    )
end

local function makeCF(pos, dir)
    local c = CFrame.new(pos)
    if CFG.velFollow > 0 and dir and dir.Magnitude > 0.01 then
        c = CFrame.lookAt(pos, pos + dir.Unit)
        local j = CFG.velFollow * 0.4
        c = c * CFrame.Angles((rng:NextNumber()-0.5)*j, (rng:NextNumber()-0.5)*j, (rng:NextNumber()-0.5)*j)
    end
    if CFG.randOrient then
        c = c * CFrame.Angles(rng:NextNumber()*math.pi*2, rng:NextNumber()*math.pi*2, rng:NextNumber()*math.pi*2)
    end
    return c
end

local function driftDir3D(t)
    local nx, ny, nz = 0, 0, 0
    local amp, f = 1, 0.00007
    for i = 1, 6 do
        nx = nx + math.noise(t*f, 13.7*i, 0) * amp
        ny = ny + math.noise(0, t*f, 31.1*i) * amp
        nz = nz + math.noise(7.3*i, 0, t*f) * amp
        f = f * 2.37; amp = amp * 0.48
    end
    local sp = t * 0.00073
    nx = nx + math.sin(sp*1.618)*0.35
    ny = ny + math.cos(sp*2.718)*0.35
    nz = nz + math.sin(sp*1.300)*0.35
    local len = math.sqrt(nx*nx + ny*ny + nz*nz)
    if len < 0.001 then return 1, 0, 0 end
    return nx/len, ny/len, nz/len
end


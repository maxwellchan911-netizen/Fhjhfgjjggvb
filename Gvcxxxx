local xorState = os.clock() * 1e9 + 12345
local function xorShift()
    xorState = bit32.bxor(xorState, bit32.lshift(xorState, 13))
    xorState = bit32.bxor(xorState, bit32.rshift(xorState, 7))
    xorState = bit32.bxor(xorState, bit32.lshift(xorState, 17))
    xorState = xorState % 2147483647
    return xorState / 2147483647
end


local function scan()
    local list, sum = {}, Vector3.new()
    local nearR = CFG.evRadius * CFG.evTrigger
    local scanR = CFG.evRadius * 3
    local minD, closestPos, closestVel = math.huge, nil, Vector3.new()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local h = p.Character:FindFirstChild("HumanoidRootPart")
            local hp = p.Character:FindFirstChildOfClass("Humanoid")
            if h and hp and hp.Health > 0 then
                local v = h.AssemblyLinearVelocity
                local a = h.AssemblyLinearAcceleration or Vector3.new()
                local L = CFG.lead
                local pred = h.Position + v*L + a*(L*L*0.5)
                local d = (pred - target).Magnitude
                if d < scanR then
                    local isNear = d < nearR
                    local velWeight = 1 + math.min(1.5, v.Magnitude/1000)
                    list[#list+1] = { pos=pred, dist=d, vel=v, near=isNear, weight=velWeight }
                    if isNear then
                        sum = sum + (pred-target).Unit * velWeight / math.max(d, 1e3)
                        if d < minD then minD=d; closestPos=pred; closestVel=v end
                    end
                end
            end
        end
    end
    return list, sum, minD, closestPos, closestVel
end

local function pressure(threats, minD)
    if #threats == 0 then return 0 end
    local closest = math.max(0, 1 - minD / (CFG.evRadius*2))
    local predictive = 0
    if CFG.predPressure then
        for _, t in ipairs(threats) do
            if not t.near and t.vel.Magnitude > 100 then
                local rel = t.pos - target
                local vv = t.vel:Dot(t.vel)
                if vv > 100 then
                    local ttc = rel:Dot(t.vel)/vv
                    if ttc > 0 and ttc < 0.5 then
                        local fd = (t.pos + t.vel*ttc - target).Magnitude
                        if fd < CFG.evRadius then
                            predictive = predictive + (1 - fd/CFG.evRadius)*0.4*t.weight
                        end
                    end
                end
            end
        end
    end
    local vw = 0
    for _, t in ipairs(threats) do vw = vw + t.weight end
    local countP = math.min(1, vw/5)*0.3
    return math.min(1, closest + predictive + countP)
end

local function track(pos)
    motionHist[motionN % 30 + 1] = pos
    motionN = motionN + 1
    if motionN < 15 then return end
    local n = math.min(motionN, 30)
    local cx, cy, cz = 0, 0, 0
    for i = 1, n do local p = motionHist[i]; cx=cx+p.X; cy=cy+p.Y; cz=cz+p.Z end
    local c = Vector3.new(cx/n, cy/n, cz/n)
    local v = 0
    for i = 1, n do v = v + (motionHist[i] - c).Magnitude end
    motionVar = v/n
end

local function boost()
    if not CFG.motionBoost then return 1 end
    local t = CFG.radius * 0.35
    if motionVar < t then return 1 + (t - motionVar)/t*2 end
    return 1
end

local function decayEv(dt)
    local m = evOffset.Magnitude
    if m < 1 then evOffset = Vector3.new(); return end
    local mx = CFG.radius * CFG.evMax
    if m > mx then
        if m > mx * 0.8 then
            local angle = rng:NextNumber() * math.pi * 0.6
            evOffset = (CFrame.Angles(0, angle * rSign(), 0) * evOffset)
        end
        evOffset = evOffset.Unit * mx
        m = mx
    end
    evOffset = evOffset * math.max(0, 1 - CFG.evDecay*dt)
end

local function findGap3D(threats, lookahead, dist)
    local n = #threats
    if n == 0 then return Vector3.new(0,0,1) end
    local samples = math.clamp(n * 8, 32, 96)
    local boundary = CFG.radius * 0.93
    local f1, f2 = {}, {}
    for i = 1, n do
        f1[i] = threats[i].pos + threats[i].vel * lookahead
        f2[i] = threats[i].pos + threats[i].vel * (lookahead * 2.5)
    end
    local bestDir, bestScore = nil, -math.huge
    for i = 0, samples - 1 do
        local dir = fibSpherePoint(i, samples, 1)
        local test = target + dir * dist
        local valid = true
        if CFG.evBoundary then
            local off = test - basePos
            if off.Magnitude > boundary then
                local nn = off.Unit
                dir = dir - nn * dir:Dot(nn) * 1.3
                if dir.Magnitude < 0.01 then valid = false
                else
                    dir = dir.Unit
                    test = target + dir * dist
                    if (test - basePos).Magnitude > CFG.radius then valid = false end
                end
            end
        end
        if valid then
            local minGap = math.huge
            for j = 1, n do
                local w = math.max(threats[j].weight, 1)
                local d1 = (f1[j] - test).Magnitude / w
                if d1 < minGap then minGap = d1 end
                local d2 = (f2[j] - test).Magnitude / w
                if d2 < minGap then minGap = d2 end
            end
            if minGap > bestScore then bestScore = minGap; bestDir = dir end
        end
    end
    return bestDir or Vector3.new(0,0,1)
end

local function findGap2D(threats, lookahead, dist)
    local n = #threats
    if n == 0 then return Vector3.new(0,0,1) end
    local f1, f2 = {}, {}
    for i = 1, n do
        f1[i] = threats[i].pos + threats[i].vel * lookahead
        f2[i] = threats[i].pos + threats[i].vel * (lookahead * 2.5)
    end
    local samples = 24
    local bestDir, bestScore = Vector3.new(0,0,1), -math.huge
    for i = 0, samples - 1 do
        local a = (i/samples) * math.pi * 2
        local dir = Vector3.new(math.cos(a), 0, math.sin(a))
        local test = target + dir * dist
        local minGap = math.huge
        for j = 1, n do
            local w = math.max(threats[j].weight, 1)
            local d1 = (f1[j] - test).Magnitude / w
            if d1 < minGap then minGap = d1 end
            local d2 = (f2[j] - test).Magnitude / w
            if d2 < minGap then minGap = d2 end
        end
        if minGap > bestScore then bestScore = minGap; bestDir = dir end
    end
    return bestDir
end

local function evade(threats, sum, minD, closestVel)
    if not CFG.evade or evCD > 0 then return end
    local immediate = minD < CFG.evRadius * CFG.evTrigger
    local anticipate, antDir = false, Vector3.new()
    if CFG.anticipate then
        for _, t in ipairs(threats) do
            if not t.near and t.vel.Magnitude > 10 then
                local vv = t.vel:Dot(t.vel)
                if vv > 100 then
                    local rel = t.pos - target
                    local ttc = rel:Dot(t.vel)/vv
                    if ttc > 0 and ttc < 0.4 then
                        local fut = t.pos + t.vel*ttc
                        if (fut - target).Magnitude < CFG.evRadius * 0.5 then
                            local perp = t.vel:Cross(Vector3.new(0,1,0))
                            if perp.Magnitude > 0.01 then
                                anticipate = true
                                antDir = antDir + perp.Unit * rSign()
                            end
                        end
                    end
                end
            end
        end
    end
    if not immediate and not anticipate then return end
    evCD = CFG.evCD
    local hpScale = 1
    if hum and hum.MaxHealth > 0 and hum.Health < hum.MaxHealth*0.5 then hpScale = 1.5 end
    local amt = CFG.evSpeed * CFG.evStrength * 0.05 * hpScale

    if immediate then
        local near = {}
        for _, t in ipairs(threats) do if t.near then near[#near+1] = t end end
        if #near > 0 then
            local fall = 1 + (1 - minD/(CFG.evRadius*CFG.evTrigger)) * 4
            local away = sum.Magnitude > 0.001 and -sum.Unit or rVec(1).Unit
            local awayH = Vector3.new(away.X, 0, away.Z)
            if awayH.Magnitude > 0.05 then awayH = awayH.Unit else awayH = away end
            local dir = awayH
            if CFG.curve then
                dir = CFG.ev3D and findGap3D(near, 0.2, CFG.evRadius*0.5)
                               or  findGap2D(near, 0.2, CFG.evRadius*0.5)
                if CFG.ev3D and math.abs(dir.Y) > 0.9 then
                    dir = findGap2D(near, 0.2, CFG.evRadius*0.5)
                end
            elseif CFG.smart and closestVel.Magnitude > 100 then
                local perp = closestVel:Cross(Vector3.new(0,1,0))
                if perp.Magnitude > 0.01 then
                    perp = perp.Unit
                    if perp:Dot(awayH) < 0 then perp = -perp end
                    dir = (perp*0.7 + awayH*0.3).Unit
                end
            end
            dir = (dir + rVec(0.25).Unit * 0.25).Unit
            evOffset = evOffset + dir * amt * fall
            if minD < CFG.evRadius * 0.4 then
                evOffset = evOffset + Vector3.new(0, CFG.evVert*fall*0.05*rSign(), 0)
            end
            if #near >= 3 then evOffset = evOffset * 1.15 end
        end
    end
    if anticipate and antDir.Magnitude > 0.01 then
        evOffset = evOffset + antDir.Unit * amt * 0.6
    end
    local mx = CFG.radius * CFG.evMax
    if evOffset.Magnitude > mx then evOffset = evOffset.Unit * mx end
end

local function clampPos(pos)
    local off = pos - basePos
    local m = off.Magnitude
    local R = CFG.radius
    if m < R * 0.85 then return pos end
    if m > R then
        local overshoot = m - R
        local inward = math.min(overshoot * 1.2, R * 0.15)
        return pos - off.Unit * (overshoot + inward)
    end
    local k = (m - R*0.85) / (R*0.15)
    return pos - off.Unit * R * k * 0.03
end

local function buildThreatSnapshot(threats)
    local list = {}
    for i, t in ipairs(threats) do
        local vmag = t.vel.Magnitude
        list[i] = {
            pos = t.pos,
            futurePos = t.pos + t.vel*0.15,
            vel = t.vel,
            velUnit = vmag > 0.01 and t.vel.Unit or Vector3.new(),
            velMag = vmag,
            weight = t.weight,
            dist = t.dist,
        }
    end
    local horizon = {}
    for s = 1, CFG.qLookAhead do
        local step = {}
        for i, t in ipairs(threats) do
            step[i] = { pos = t.pos + t.vel*(s*0.1), weight = t.weight }
        end
        horizon[s] = step
    end
    return { list = list, horizon = horizon }
end

local function horizonScore(pos, horizon)
    if #horizon == 0 then return 0 end
    local score = 0
    for s = 1, #horizon do
        local step = horizon[s]
        if #step > 0 then
            local minD = math.huge
            for i = 1, #step do
                local t = step[i]
                local d = (t.pos - pos).Magnitude / t.weight
                if d < minD then minD = d end
            end
            score = score + (minD / math.max(CFG.evRadius, 1)) * (1/s)
        end
    end
    return score
end

local function scoreDestFast(c, snap, ev, pres)
    local realC = c + ev
    local s, penalty = 0, 0
    local list = snap.list
    for i = 1, #list do
        local t = list[i]
        local nowD = (t.pos - realC).Magnitude
        local futD = (t.futurePos - realC).Magnitude
        local worst = math.min(nowD, futD)
        s = s + (worst / math.max(t.dist, 1e6) / t.weight) ^ 2
        if t.velMag > 100 and futD < CFG.evRadius * 2 then
            local toward = (realC - t.futurePos).Unit:Dot(t.velUnit)
            if toward > 0.5 then penalty = penalty + (toward - 0.5) * 4 * t.weight end
        end
    end
    if CFG.horizonWeight > 0 and #list > 0 then
        s = s + horizonScore(realC, snap.horizon) * CFG.horizonWeight
    end
    local rad = (c - basePos).Magnitude / CFG.radius
    if rad > 0.85 then s = s - (rad - 0.85) * 30 end
    if pres < 0.4 and qState then
        local prox = (c - qState).Magnitude / CFG.radius
        s = s - math.abs(prox - 0.25) * 10 * (1 - pres/0.4)
    end
    if (c - target).Magnitude < CFG.radius * 0.15 then s = s - 2 end
    local thresh = CFG.radius * 0.12
    for i = 1, #visitedPos do
        local v = visitedPos[i]
        local d = (c - v.pos).Magnitude
        if d < thresh then
            local age = elapsed - v.t
            if age < 1.5 then
                s = s - (1 - d/thresh) * (1 - age/1.5) * 6
            end
        end
    end
    return s - penalty
end

-- IMPROVED: smart first-guess (opposite of threat centroid) + explorative random
local function pickDestFast(snap, pres, ev)
    local fpsScale = math.clamp((1/60)/avgDt, 0.3, 1)
    local n = math.max(6, math.floor((CFG.qSamples + pres*30) * fpsScale))
    local best, bestS = nil, -math.huge

    -- Seed with a heuristic guess: escape opposite of threat centroid
    if #snap.list > 0 then
        local cx, cy, cz = 0, 0, 0
        for i = 1, #snap.list do
            local t = snap.list[i]
            cx = cx + t.pos.X; cy = cy + t.pos.Y; cz = cz + t.pos.Z
        end
        local cnt = #snap.list
        local away = basePos - Vector3.new(cx/cnt, cy/cnt, cz/cnt)
        if away.Magnitude > 1 then
            local guess = basePos + away.Unit * CFG.radius * 0.7
            local off = guess - basePos
            if off.Magnitude > CFG.radius * 0.9 then
                guess = basePos + off.Unit * CFG.radius * 0.9
            end
            local s = scoreDestFast(guess, snap, ev, pres)
            if s > bestS then bestS = s; best = guess end
        end
    end

    for _ = 1, n do
        local c = basePos + rVec(CFG.radius * 0.9)
        local s = scoreDestFast(c, snap, ev, pres)
        if s > bestS then bestS = s; best = c end
    end
    return best or (basePos + rVec(CFG.radius * 0.9))
end

local function threatMoved(threats, thresh)
    if not qThreatSnap then return true end
    if #threats ~= #qThreatSnap then return true end
    for i, t in ipairs(threats) do
        if (t.pos - qThreatSnap[i]).Magnitude > thresh then return true end
    end
    return false
end

local function snapshotThreats(threats)
    qThreatSnap = {}
    for i, t in ipairs(threats) do qThreatSnap[i] = t.pos end
end

local function quantumStep(threats, minD)
    qAge = qAge + 1
    local forced = minD < CFG.evRadius * 0.5
    local diverging = CFG.motionBoost and motionN > 20 and motionVar < CFG.radius * 0.1
    local shifted = math.abs(qPressure - qPressureAtPick) > 0.35
                    or threatMoved(threats, CFG.radius * CFG.qPosThresh)
    local stuck = (elapsed - lastMoveT) > CFG.stuckThreshold

    if forced or diverging or shifted or stuck or qAge >= qHold or not qState then
        local snap = buildThreatSnapshot(threats)
        local newState = pickDestFast(snap, qPressure, evOffset)
        local accept = (not qState) or forced or stuck
        if not accept then
            local newS = scoreDestFast(newState, snap, evOffset, qPressure)
            local oldS = scoreDestFast(qState,  snap, evOffset, qPressure)
            accept = newS > oldS * 1.08
        end
        if accept then
            qAge = 0
            qPressureAtPick = qPressure
            local lo, hi
            if qPressure < 0.3 then lo, hi = 8, 15
            elseif qPressure < 0.7 then lo, hi = 3, 8
            else lo, hi = 1, 3 end
            if forced or diverging or stuck then qHold = 1
            else qHold = rng:NextInteger(lo, hi) end
            qState = newState
            qSpread = 0
            snapshotThreats(threats)
        else
            qHold = qAge + 2
        end
    end

    local mult = 0.15 + qPressure * 0.85
    if qPressure < 0.2 then
        qSpread = math.max(0, qSpread - CFG.radius * 0.012 * boost())
    else
        qSpread = math.min(
            qSpread + CFG.radius * 0.005 * boost() * mult,
            CFG.radius * 0.08 * mult
        )
    end
    return qState + rVec(qSpread)
end

local function novaStep(dt)
    local period = math.max(0.2, CFG.novaPeriod) * 2
    novaT = novaT + dt
    if novaT >= period or novaDir.Magnitude < 0.1 then
        novaT = novaT - period * math.floor(novaT / period)
        novaPhase = (novaPhase + 1) % CFG.novaPhases
        local th = rng:NextNumber() * math.pi * 2
        local phi = math.acos(math.clamp(2*rng:NextNumber() - 1, -1, 1))
        novaDirFrom = novaDir
        novaDir = Vector3.new(
            math.sin(phi)*math.cos(th), math.cos(phi), math.sin(phi)*math.sin(th)
        )
        novaSmoothT = 0
    end
    if novaSmoothT < 0.12 then
        novaSmoothT = novaSmoothT + dt
        local t = math.min(1, novaSmoothT / 0.12)
        local blended = novaDirFrom:Lerp(novaDir, t)
        if blended.Magnitude > 0.01 then blended = blended.Unit
        else blended = novaDir end
        local curT = novaT / period
        local pulse = math.sin(curT * math.pi)
        local r = CFG.radius * (0.15 + pulse * 0.8)
        local pos = basePos + blended * r
        if CFG.novaPulse then pos = pos + rVec(CFG.radius * 0.05 * (1 - pulse)) end
        return pos
    end
    local t = novaT / period
    local pulse = math.sin(t * math.pi)
    local r = CFG.radius * (0.15 + pulse * 0.8)
    local pos = basePos + novaDir * r
    if CFG.novaPulse then pos = pos + rVec(CFG.radius * 0.05 * (1 - pulse)) end
    return pos
end

local function methodAnchor(m, dt)
    if m == "Drift" then
        local dx, dy, dz = driftDir3D(elapsed)
        driftDir = driftDir:Lerp(Vector3.new(dx,dy,dz).Unit, CFG.chaos * dt * 10)
        voidPos = voidPos + driftDir * CFG.speed * dt
        local off = voidPos - basePos
        if off.Magnitude > CFG.radius then
            local n = off.Unit
            driftDir = driftDir - 2 * driftDir:Dot(n) * n
            driftDir = (driftDir + rVec(0.3) * 0.5).Unit
            voidPos = basePos + n * CFG.radius * (0.85 + rng:NextNumber()*0.15)
        end
        return voidPos
    elseif m == "Chaos" then
        voidPos = voidPos + rVec(CFG.speed * dt * 5)
        local off = voidPos - basePos
        if off.Magnitude > CFG.radius then
            voidPos = basePos + off.Unit * CFG.radius * (0.7 + rng:NextNumber()*0.25)
        end
        return voidPos
    elseif m == "Loop" then
        local t = elapsed
        local r = CFG.radius * (0.6 + 0.25*math.sin(t*0.3) + 0.15*math.sin(t*0.73))
        return basePos + Vector3.new(
            math.cos(t*2 + math.sin(t*0.1)*3) * r,
            altJ(math.sin(t*1.3) * r * 0.2),
            math.sin(t*2 + math.sin(t*0.1)*3) * r
        )
    elseif m == "Spiral" then
        local t = elapsed
        local r = CFG.radius * (0.5 + 0.4*math.abs(math.sin(t*0.15)*math.cos(t*0.07)))
        local ph = t*3 + math.sin(t*0.2)*2
        return basePos + Vector3.new(
            math.cos(ph)*r, altJ(math.sin(t*0.5)*r*0.3), math.sin(ph)*r
        )
    elseif m == "HyperChaos" then
        local th = rng:NextNumber()*math.pi*2
        local phi = math.acos(math.clamp(2*rng:NextNumber()-1, -1, 1))
        local r = CFG.radius * (rng:NextNumber() ^ CFG.skew)
        return basePos + Vector3.new(
            r*math.sin(phi)*math.cos(th), altJ(r*math.cos(phi)), r*math.sin(phi)*math.sin(th)
        )
    elseif m == "Scatter" then
        return basePos + Vector3.new(
            triR()*CFG.radius, altJ(triR()*CFG.alt), triR()*CFG.radius
        ) + rVec(CFG.mtpSpread)
    elseif m == "Rift" then
        local snap = CFG.radius * 0.7
        local rx = (xorShift()-0.5)*2*CFG.radius
        local rz = (xorShift()-0.5)*2*CFG.radius
        if rng:NextNumber() < 0.6 then rx = rx >= 0 and snap or -snap end
        if rng:NextNumber() < 0.6 then rz = rz >= 0 and snap or -snap end
        local ry = altJ((xorShift()-0.5)*2*CFG.radius)
        return basePos + Vector3.new(rx, ry, rz)
    elseif m == "Storm" then
        local t = elapsed
        local x = math.sin(t*7.3)*CFG.radius*0.4 + math.sin(t*13.1)*CFG.radius*0.3 + math.cos(t*3.7)*CFG.radius*0.3
        local y = altJ(math.cos(t*5.1)*CFG.radius*0.2 + math.sin(t*11.7)*CFG.radius*0.15)
        local z = math.cos(t*9.9)*CFG.radius*0.4 + math.cos(t*17.3)*CFG.radius*0.3 + math.sin(t*2.9)*CFG.radius*0.3
        return basePos + Vector3.new(x, y, z) + rVec(CFG.radius*0.1)
    end
    return voidPos
end

local function dwellWobble(amount)
    return Vector3.new(
        math.sin(elapsed*3.7 + dwellSeed)*amount,
        math.sin(elapsed*2.3 + dwellSeed*1.4)*amount*0.5,
        math.cos(elapsed*4.1 + dwellSeed*0.8)*amount
    )
end

local function stepDrift(dt, threats, minD)
    local m = CFG.method
    if m == "Quantum" then return quantumStep(threats, minD) + evOffset end
    if m == "Nova" then return novaStep(dt) + evOffset end
    if TELEPORT_METHODS[m] and CFG.dwell then
        local forced = minD < CFG.evRadius * 0.5
        if forced and (elapsed - dwellStart) < 0.035 then forced = false end
        local capHit = (elapsed - dwellStart) > CFG.dwellCap
        if forced or capHit or dwellLeft <= 0 or not dwellAnchor then
            dwellAnchor = methodAnchor(m, dt)
            dwellLeft = forced and 1 or rng:NextInteger(CFG.dMin, CFG.dMax)
            dwellSpread = CFG.radius * CFG.dJitter
            dwellSeed = rng:NextNumber() * math.pi * 2
            dwellStart = elapsed
        end
        dwellLeft = dwellLeft - 1
        dwellSpread = math.min(dwellSpread + CFG.radius*0.004*boost(), CFG.radius*CFG.dJitter*2.5)
        local wobble = dwellWobble(CFG.radius*0.008*boost())
        return dwellAnchor + wobble + rVec(dwellSpread*0.12) + evOffset
    end
    return methodAnchor(m, dt) + evOffset
end

local function updatePhase(dt)
    if not CFG.phase then return end
    phaseT = phaseT + dt
    if phaseT >= CFG.phaseInt then
        phaseT = 0
        local pool
        local trend = qPressure - qPressurePrev
        if CFG.phaseAdaptive then
            if trend > 0.05 or qPressure >= 0.7 then pool = CFG.phaseHigh
            elseif qPressure < 0.3 then pool = CFG.phaseLow
            else pool = CFG.phaseMid end
        else
            pool = CFG.phaseMethods
        end
        phaseIdx = (phaseIdx % #pool) + 1
        local nm = pool[phaseIdx]
        if nm ~= CFG.method then
            if nm == "Quantum" then qState = nil; qThreatSnap = nil; dwellAnchor = nil end
            if nm == "Nova" then novaT = 0; novaPhase = 0; novaDir = Vector3.new(0,0,1) end
            CFG.method = nm
        end
    end
end

----------------------------------------------------------------
-- MIRROR MANIPULATION
----------------------------------------------------------------

local function mirrorAxisFromThreats(threats)
    if #threats == 0 then return "X" end
    local cx, cy, cz = 0, 0, 0
    for _, t in ipairs(threats) do
        cx = cx + t.pos.X; cy = cy + t.pos.Y; cz = cz + t.pos.Z
    end
    local n = #threats
    cx, cy, cz = cx/n, cy/n, cz/n
    local dx, dy, dz = target.X - cx, target.Y - cy, target.Z - cz
    local ax, ay, az = math.abs(dx), math.abs(dy), math.abs(dz)
    if ax >= ay and ax >= az then return "X"
    elseif ay >= az then return "Y"
    else return "Z" end
end

local function applyMirror(pos, dir, threats, dt)
    if not CFG.mirror then return pos, dir end

    local doMirror = false
    if CFG.mirrorMode == "Always" then
        doMirror = true
    elseif CFG.mirrorMode == "Alternate" then
        mirrorTimer = mirrorTimer + dt
        if mirrorTimer >= CFG.mirrorRate then
            mirrorTimer = mirrorTimer - CFG.mirrorRate
            mirrorOn = not mirrorOn
        end
        doMirror = mirrorOn
    elseif CFG.mirrorMode == "Random" then
        mirrorTimer = mirrorTimer + dt
        if mirrorTimer >= CFG.mirrorRate then
            mirrorTimer = mirrorTimer - CFG.mirrorRate
            mirrorOn = rng:NextNumber() < 0.5
        end
        doMirror = mirrorOn
    elseif CFG.mirrorMode == "Threat" then
        doMirror = #threats > 0
    end

    if not doMirror then return pos, dir end

    local axis = CFG.mirrorAxis
    if axis == "Random" then
        axis = ({"X","Y","Z"})[rng:NextInteger(1,3)]
    elseif axis == "Threat" then
        axis = mirrorAxisFromThreats(threats)
    end

    local rel = pos - basePos
    if axis == "X" then
        return basePos + Vector3.new(-rel.X, rel.Y, rel.Z), Vector3.new(-dir.X, dir.Y, dir.Z)
    elseif axis == "Y" then
        return basePos + Vector3.new(rel.X, -rel.Y, rel.Z), Vector3.new(dir.X, -dir.Y, dir.Z)
    elseif axis == "Z" then
        return basePos + Vector3.new(rel.X, rel.Y, -rel.Z), Vector3.new(dir.X, dir.Y, -dir.Z)
    elseif axis == "All" then
        return basePos - rel, -dir
    end
    return pos, dir
end

----------------------------------------------------------------
-- Decoys (burst / ghost / chaff)
----------------------------------------------------------------

local function burst(hrp, dir)
    if not CFG.mtp then return end
    -- Adaptive count: more decoys when threatened
    local count = CFG.mtpCount + math.floor(qPressure * 6)
    for i = 1, count do
        local off
        if CFG.mtpFib then
            off = fibSpherePoint(i-1, count, CFG.mtpSpread * (0.5 + rng:NextNumber()*0.5))
        elseif CFG.mtpStruct and dir and dir.Magnitude > 0.01 then
            local fwd = dir.Unit
            local right = fwd:Cross(Vector3.new(0,1,0))
            if right.Magnitude < 0.01 then right = Vector3.new(1,0,0) end
            right = right.Unit
            local up = right:Cross(fwd).Unit
            local dirs = { fwd, -fwd, right, -right, up, -up,
                           (fwd+right).Unit, (fwd-right).Unit,
                           (fwd+up).Unit, (fwd-up).Unit }
            off = (dirs[i] or fwd) * CFG.mtpSpread * (0.8 + rng:NextNumber()*0.4)
        else
            off = rVec(CFG.mtpSpread)
        end
        pcall(_setCF, hrp, CFrame.new(target + off))
    end
end

-- IMPROVED: adaptive count + real-anchor (pre-mirror) dual ghosting
local function ghosts(hrp, anchor, dir, pres, realAnchor)
    if not CFG.ghost then return end
    local dynSpread = CFG.ghostDynamic and (CFG.ghostSpread * (1 + pres*2)) or CFG.ghostSpread
    local useTrail = CFG.ghostTrail and dir and dir.Magnitude > 0.01
    local trailDir = useTrail and dir.Unit or nil

    local baseCount = CFG.ghostCount + math.floor(pres * 5)
    for i = 1, baseCount do
        local pos
        if CFG.ghostRing then
            local a = (i/baseCount)*math.pi*2 + rng:NextNumber()*0.6
            local vertJitter = (rng:NextNumber()-0.5)*dynSpread*(0.35 + pres*0.5)
            pos = anchor + Vector3.new(math.cos(a)*dynSpread, vertJitter, math.sin(a)*dynSpread)
        elseif useTrail then
            local t = (i/baseCount)*dynSpread
            pos = anchor - trailDir*t + xVec(dynSpread*0.3)
        else
            pos = anchor + xVec(dynSpread)
        end
        pcall(_setCF, hrp, CFrame.new(pos))
    end

    -- Dual ghost: also frame the unmirrored anchor so both sides are visible
    if CFG.mirrorDual and CFG.mirror and realAnchor and (realAnchor - anchor).Magnitude > CFG.radius * 0.05 then
        local extra = math.max(2, math.ceil(baseCount / 2))
        for i = 1, extra do
            local pos = realAnchor + xVec(dynSpread * 0.7)
            pcall(_setCF, hrp, CFrame.new(pos))
        end
    end
end

local function chaff(hrp, dir)
    if not (CFG.velSpoof or CFG.pulse) then return end
    local vel = Vector3.new()
    if CFG.velSpoof then
        if CFG.chaffMode == "random" then
            vel = rVec(CFG.velForce)
        else
            vel = dir * CFG.velForce * (0.5 + rng:NextNumber()*0.5)
                  + Vector3.new(0, (rng:NextNumber()-0.5)*CFG.velForce, 0)
        end
    end
    if CFG.pulse then vel = vel + rVec(CFG.pulseForce) end
    pcall(_setVel, hrp, vel)
end

----------------------------------------------------------------
-- Main tick
----------------------------------------------------------------

local function tick(dt)
    if evCD > 0 then evCD = evCD - dt end
    if hum and hum.Health <= 0 then return end
    updatePhase(dt)
    decayEv(dt)

    if math.abs(basePos.Y - CFG.alt) > 1 then
        basePos = Vector3.new(basePos.X, basePos.Y + (CFG.alt - basePos.Y) * math.min(1, dt * 1.5), basePos.Z)
    end

    local threats, sum, minD, closestPos, closestVel = scan()
    evade(threats, sum, minD, closestVel)
    qPressurePrev = qPressure
    qPressure = pressure(threats, minD)

    local prev = target
    local realTarget = clampPos(stepDrift(dt, threats, minD))

    -- Track pre-mirror motion for coherence / stuck detection
    track(realTarget)

    local jump = realTarget - prev
    if jump.Magnitude > 0.01 then jump = jump.Unit else jump = Vector3.new() end

    -- Apply mirror manipulation (mirror preserves bounds since |offset| preserved)
    target, jump = applyMirror(realTarget, jump, threats, dt)

    -- Track visited positions (both real and mirrored) for coherence
    if (realTarget - prev).Magnitude > CFG.radius * 0.03 then
        lastMoveT = elapsed
        visitedPos[#visitedPos + 1] = { pos = realTarget, t = elapsed }
        if target ~= realTarget then
            visitedPos[#visitedPos + 1] = { pos = target, t = elapsed }
        end
        while #visitedPos > 16 do table.remove(visitedPos, 1) end
        while #visitedPos > 0 and visitedPos[1].t < elapsed - 1.5 do table.remove(visitedPos, 1) end
    end

    local effSkip = math.max(0.01, CFG.skip * (1 - qPressure * 0.8))
    frameOK = (rng:NextNumber() >= effSkip) or snapBoost > 0

    local hrp = root
    if not hrp then return end

    if CFG.snapCheck and lastSet then
        local thr = CFG.adSnap
            and math.max(CFG.radius * 0.001, 1e5)
            or  math.max(CFG.radius * 0.01,  1e6)
        if (hrp.Position - lastSet).Magnitude > thr then
            snapBoost = 3
            if CFG.snapRetarget then
                qState = nil; qThreatSnap = nil; dwellAnchor = nil; dwellLeft = 0
            end
        end
    end

    if not frameOK then return end

    pcall(_setCF, hrp, makeCF(target, jump))
    pcall(_setVel, hrp, Vector3.zero)
    pcall(_setAng, hrp, Vector3.zero)
    lastSet = target

    heartFrame = heartFrame + 1
    local doGhost = heartFrame % CFG.ghostRate == 0 or snapBoost > 0
    local doMtp   = heartFrame % CFG.mtpRate == 0 or snapBoost > 0
    if doGhost then ghosts(hrp, target, jump, qPressure, realTarget) end
    if doMtp then
        burst(hrp, jump)
        if rng:NextNumber() < 0.25 then burst(hrp, jump) end
    end
    chaff(hrp, jump)
    if snapBoost > 0 then snapBoost = snapBoost - 1 end
end

function startVoid()
    kill("void"); kill("voidRender")
    if root then voidPos = Vector3.new(root.Position.X, CFG.alt, root.Position.Z)
    else voidPos = Vector3.new(0, CFG.alt, 0) end
    basePos = Vector3.new(0, CFG.alt, 0)
    target = voidPos
    elapsed, phaseT, phaseIdx = 0, 0, 1
    evOffset = Vector3.new()
    qState, qHold, qAge, qSpread = nil, 1, 0, 0
    qPressure, qPressureAtPick, qPressurePrev = 0, 0, 0
    qThreatSnap = nil
    dwellAnchor, dwellLeft, dwellSpread, dwellSeed, dwellStart = nil, 0, 0, 0, 0
    motionHist, motionN, motionVar = {}, 0, 1
    visitedPos = {}
    lastMoveT = 0; lastSet, heartFrame, snapBoost = nil, 0, 0; frameOK = true
    novaT, novaPhase = 0, 0
    novaDir = Vector3.new(0,0,1); novaDirFrom = novaDir; novaSmoothT = 1
    avgDt = 1/60
    mirrorOn, mirrorTimer = false, 0

    local errCount = 0
    conns.void = RunService.Heartbeat:Connect(function(dt)
        if not CFG.enabled then kill("void"); return end
        dt = math.min(dt, 0.1)
        avgDt = avgDt * 0.92 + dt * 0.08
        elapsed = elapsed + dt
        local ok, err = pcall(tick, dt)
        if not ok then
            errCount = errCount + 1
            if errCount == 10 then warn("[DeepSeek.Lua] void tick errors: " .. tostring(err)) end
        end
    end)

    if CFG.subTick then
        conns.voidRender = RunService.RenderStepped:Connect(function()
            if not CFG.enabled then kill("voidRender"); return end
            if not frameOK then return end
            local hrp = root
            if not hrp then return end
            pcall(_setCF, hrp, makeCF(target, nil))
            pcall(_setVel, hrp, Vector3.zero)
            pcall(_setAng, hrp, Vector3.zero)
            ghosts(hrp, target, nil, qPressure, nil)
        end)
    end
end

function stopVoid() kill("void"); kill("voidRender") end

-- orbit
local orb = { enabled=false, speed=90, dist=8, height=0, lerp=0.3,
    mode="Circle", predict=false, predStrength=0.2, face=true, autoLock=50 }
local orbAngle, orbElapsed, orbRadius = 0, 0, 0

function startOrbit()
    kill("orbit")
    if hum and hum.Parent and hum.Health > 0 then
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
    end
    orbAngle, orbElapsed, orbRadius = 0, 0, orb.dist
    conns.orbit = RunService.Heartbeat:Connect(function(dt)
        if not orb.enabled or not root then
            if not orb.enabled then kill("orbit") end
            return
        end
        local tgt = closest()
        if not tgt or not tgt.Character then return end
        local hrp = tgt.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        if (root.Position - hrp.Position).Magnitude > orb.autoLock then return end
        local tp = hrp.Position
        if orb.predict then tp = tp + hrp.AssemblyLinearVelocity * orb.predStrength end
        orbAngle = orbAngle + math.rad(orb.speed) * dt
        orbElapsed = orbElapsed + dt
        local r, h = orb.dist, orb.height
        local x, y, z = 0, 0, 0
        if orb.mode == "Circle" then x=math.cos(orbAngle)*r; z=math.sin(orbAngle)*r; y=h
        elseif orb.mode == "Figure 8" then x=math.sin(orbAngle)*r; z=math.sin(orbAngle)*math.cos(orbAngle)*r*0.7; y=h
        elseif orb.mode == "Spiral In" then orbRadius=math.max(1, orbRadius-dt*2); x=math.cos(orbAngle)*orbRadius; z=math.sin(orbAngle)*orbRadius; y=h
        elseif orb.mode == "Spiral Out" then orbRadius=math.min(orb.dist*2, orbRadius+dt*2); x=math.cos(orbAngle)*orbRadius; z=math.sin(orbAngle)*orbRadius; y=h
        elseif orb.mode == "Bounce" then x=math.cos(orbAngle)*r; z=math.sin(orbAngle)*r; y=h+math.sin(orbElapsed*3)*5 end
        local dst = tp + Vector3.new(x,y,z)
        local smooth = root.Position:Lerp(dst, orb.lerp)
        if orb.face then root.CFrame = CFrame.new(smooth, Vector3.new(tp.X, smooth.Y, tp.Z))
        else root.CFrame = CFrame.new(smooth) end
    end)
end
function stopOrbit()
    kill("orbit"); orb.enabled = false
    if not (hum and hum.Parent and hum.Health > 0) then return end
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    task.delay(0.1, function()
        if not (hum and hum.Parent and hum.Health > 0) then return end
        pcall(function()
            if hum:GetState() == Enum.HumanoidStateType.Physics then
                hum:ChangeState(Enum.HumanoidStateType.Freefall)
            end
        end)
    end)
end

